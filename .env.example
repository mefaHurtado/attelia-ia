# Copia como .env y cambia el dominio por el tuyo ANTES de desplegar.
SITE_DOMAIN=tu-dominio.com
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
# Umbral de distancia Chroma. Calibrar con ejemplos positivos y negativos.
RAG_MAX_DISTANCE=1.35
# Entorno local sin Docker (backend):
ATTELIA_DB=data/attelia.db
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
OLLAMA_BASE_URL=http://localhost:11434
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
